{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ntpc-youbike/task_response.schema.json",
  "title": "Public task response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "case_id",
    "display_name",
    "district_id",
    "action_label",
    "priority_band",
    "route_label",
    "eta_band",
    "status",
    "updated_at",
    "task_type"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^task-[a-z0-9][a-z0-9-]{3,64}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^case-[a-z0-9-]{4,60}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "district_id": {
      "type": "string",
      "pattern": "^ntpc-[a-z0-9-]{2,40}$"
    },
    "action_label": {
      "type": "string",
      "enum": [
        "add_bikes",
        "pull_bikes",
        "observe",
        "rebalance_window"
      ]
    },
    "priority_band": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "route_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "eta_band": {
      "type": "string",
      "enum": [
        "none",
        "under_10m",
        "under_20m",
        "over_20m"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "COMPLETED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "add_bikes",
        "pull_bikes",
        "observe",
        "rebalance_window"
      ]
    }
  }
}
