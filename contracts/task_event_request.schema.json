{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ntpc-youbike/task_event_request.schema.json",
  "title": "Public task event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_type",
    "event_id",
    "device_hash",
    "signature",
    "occurred_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^task-[a-z0-9][a-z0-9-]{3,64}$"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "add_bikes",
        "pull_bikes",
        "observe",
        "rebalance_window"
      ]
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt-[A-Za-z0-9_-]{8,80}$"
    },
    "device_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_-]+\\.[a-f0-9]{64}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
