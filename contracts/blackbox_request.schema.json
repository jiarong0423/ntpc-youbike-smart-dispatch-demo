{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ntpc-youbike-demo/contracts/blackbox_request.schema.json",
  "title": "YouBike Black Box Evaluation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "requested_at",
    "nonce",
    "view",
    "limit"
  ],
  "properties": {
    "schema_version": {
      "const": "youbike.blackbox_request.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req-[a-z0-9][a-z0-9-]{8,80}$"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{24,96}$"
    },
    "view": {
      "const": "district_dispatch_summary"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  }
}
